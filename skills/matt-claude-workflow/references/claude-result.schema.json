{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude Code Structured Work Unit Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "session_id",
    "commits",
    "tests",
    "concerns",
    "context_requests",
    "permission_requests"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "DONE_WITH_CONCERNS",
        "NEEDS_CONTEXT",
        "BLOCKED",
        "PERMISSION_REQUIRED"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "format": "uuid" },
    "commits": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "summary"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed", "not_run"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "concerns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "context_requests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "permission_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "scope", "reason"],
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PERMISSION_REQUIRED" } }, "required": ["status"] },
      "then": { "properties": { "permission_requests": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "DONE_WITH_CONCERNS" } }, "required": ["status"] },
      "then": { "properties": { "concerns": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "NEEDS_CONTEXT" } }, "required": ["status"] },
      "then": { "properties": { "context_requests": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "DONE" } }, "required": ["status"] },
      "then": {
        "properties": {
          "concerns": { "maxItems": 0 },
          "context_requests": { "maxItems": 0 },
          "permission_requests": { "maxItems": 0 },
          "tests": {
            "minItems": 1,
            "not": {
              "contains": {
                "type": "object",
                "required": ["status"],
                "properties": { "status": { "enum": ["failed", "not_run"] } }
              }
            }
          }
        }
      }
    }
  ]
}
