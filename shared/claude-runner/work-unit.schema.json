{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex Claude Work Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "work_unit_id", "workflow", "native_ref", "working_root",
    "fixed_point", "executor", "status", "segments", "permissions", "runtime",
    "progress_claims", "evidence", "commits", "result"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "work_unit_id": {"type": "string", "format": "uuid"},
    "workflow": {"enum": ["superpowers", "matt"]},
    "native_ref": {"type": "string"},
    "working_root": {"type": "string"},
    "fixed_point": {"type": "string"},
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["agent", "capability"],
      "properties": {"agent": {"const": "claude-code"}, "capability": {"enum": ["sonnet", "opus"]}}
    },
    "status": {"enum": ["initialized", "running", "permission_required", "interrupted", "backend_failure", "implementation_complete", "finished"]},
    "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/segment"}},
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["initial", "approved", "pending", "resolved"],
      "properties": {"initial": {"type": "array"}, "approved": {"type": "array"}, "pending": {"type": ["object", "null"]}, "resolved": {"type": "array"}}
    },
    "runtime": {"type": "object"},
    "progress_claims": {"type": "array"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["declared", "verified"],
      "properties": {"declared": {"type": "array"}, "verified": {"type": "array"}}
    },
    "commits": {"type": "array"},
    "result": {"type": ["object", "null"]}
  },
  "definitions": {
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "kind", "scope", "verification_commands", "status", "session_id", "attempt", "resume_count", "created_at", "started_at", "finished_at"],
      "properties": {
        "segment_id": {"type": "string"}, "kind": {"type": "string"}, "scope": {"type": "string"},
        "verification_commands": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["pending", "running", "permission_required", "interrupted", "complete", "failed"]},
        "session_id": {"type": ["string", "null"]}, "attempt": {"type": "integer", "minimum": 0}, "resume_count": {"type": "integer", "minimum": 0},
        "created_at": {"type": "string"}, "started_at": {"type": ["string", "null"]}, "finished_at": {"type": ["string", "null"]},
        "finding_ids": {"type": "array", "items": {"type": "string"}},
        "capability": {"enum": ["sonnet", "opus"]}
      }
    }
  }
}
